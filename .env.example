# Variables d'environnement de PetInn — modèle sans valeurs réelles.
#
# ⚠️ Le fichier .env est versionné (synchronisé avec Lovable) et ne doit contenir
# que des valeurs publiques. Les secrets serveur (clés Resend, Stripe, cron…) se
# définissent dans Lovable Cloud → Secrets, jamais dans .env.
# En local, copiez ce fichier en .env.local (non versionné) pour tester.

# --- Supabase / Lovable Cloud (gérées par Lovable) ---------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- E-mails transactionnels (Resend) ---------------------------------------
# Clé API Resend (commence par re_). Une clé « Sending access » suffit pour
# l'envoi ; une clé « Full access » permet aussi à `bun run email:check --live`
# de vérifier le domaine.
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié dans Resend. Formats acceptés :
#   PetInn <contact@petinn.fr>   ou   contact@petinn.fr
EMAIL_FROM=
# Facultatif : adresse de réponse.
EMAIL_REPLY_TO=

# --- Domaine public ----------------------------------------------------------
# Utilisé pour les liens des e-mails et la balise canonical (ex. https://petinn.fr).
# À défaut, l'origine de la requête est utilisée.
SITE_URL=

# --- Paiements (Stripe) ------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Cron d'expiration des demandes (voir docs/cron-setup.md) ---------------
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
